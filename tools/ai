#!/usr/bin/env bash

set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$ROOT_DIR/tools/lib"

show_menu() {
    clear

    echo "========================================"
    echo "        Eyan AI CLI v1.0"
    echo "========================================"
    echo
    echo "Project : Eyan AI Platform"
    echo
    echo "1) Start"
    echo "2) Feature"
    echo "3) Review"
    echo "4) Architect"
    echo "5) Code"
    echo "6) Doctor"
    echo "7) Models"
    echo "8) Help"
    echo "9) Exit"
    echo
    read -rp "Select: " choice

    case "$choice" in
        1) exec "$0" start ;;
        2) exec "$0" feature ;;
        3) exec "$0" review ;;
        4) exec "$0" architect ;;
        5) exec "$0" code ;;
        6) exec "$0" doctor ;;
        7) exec "$0" models ;;
        8) exec "$0" help ;;
        9) exit 0 ;;
        *) echo "Invalid option"; sleep 1; show_menu ;;
    esac
}

# Sprint 1 commands (start, help) and Sprint 5's feature command are implemented
# in the @eyan/ai-cli TypeScript package; this stays the stable entrypoint and
# just dispatches to it.
run_ai_cli() {
    (cd "$ROOT_DIR" && exec pnpm --filter @eyan/ai-cli run cli "$@")
}

case "${1:-}" in
    start)
        run_ai_cli start
        ;;
    feature)
        run_ai_cli feature
        ;;
    help)
        run_ai_cli help
        ;;
    review)
        exec bash "$LIB_DIR/review.sh"
        ;;
    architect)
        exec bash "$LIB_DIR/architect.sh"
        ;;
    code)
        exec bash "$LIB_DIR/code.sh"
        ;;
    doctor)
        exec bash "$LIB_DIR/doctor.sh"
        ;;
    models)
        exec bash "$LIB_DIR/models.sh"
        ;;
    "")
        show_menu
        ;;
    *)
        echo "Unknown command: $1"
        echo
        echo "Usage:"
        echo "  ./tools/ai start"
        echo "  ./tools/ai feature"
        echo "  ./tools/ai help"
        echo "  ./tools/ai review"
        echo "  ./tools/ai architect"
        echo "  ./tools/ai code"
        echo "  ./tools/ai doctor"
        echo "  ./tools/ai models"
        exit 1
        ;;
esac
