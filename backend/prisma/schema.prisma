generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  PUBLISHED
}

enum ContentType {
  BLOG
  EMAIL
  SOCIAL_MEDIA
  MARKETING_COPY
  DOCUMENTATION
}

enum ImageFormat {
  PNG
  JPG
  WEBP
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

// Mirrors ContentType's five values exactly (a GeneratedContent.type value
// casts straight across, no mapping table) plus IMAGE and PROMPT_TEMPLATE —
// the two additional real asset sources aggregated by the Asset Library.
// Adding a future asset type (e.g. VIDEO) is one new enum value + one
// migration + one case in asset.mapper.ts, never a redesign of this enum's
// existing consumers — see docs/ASSET_LIBRARY.md.
enum AssetType {
  BLOG
  EMAIL
  SOCIAL_MEDIA
  MARKETING_COPY
  DOCUMENTATION
  IMAGE
  PROMPT_TEMPLATE
}

enum ReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

model User {
  id              String   @id @default(cuid())

  email           String   @unique
  passwordHash    String
  name            String

  refreshToken    String?

  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)

  roles           UserRole[]
  savedPrompts    SavedPrompt[]
  contentProjects ContentProject[]
  reviewedAssets  AssetReview[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())

  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  users       UserRole[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())

  name        String   @unique
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now())
}

model UserRole {
  userId      String
  roleId      String

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt  DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ContentProject {
  id          String        @id @default(cuid())

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  status      ProjectStatus @default(DRAFT)

  generatedContent GeneratedContent[]
  generatedImages  GeneratedImage[]
  savedPrompts     SavedPrompt[]
  assetReviews     AssetReview[]
  assetVersions    AssetVersion[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model GeneratedImage {
  id             String           @id @default(cuid())

  projectId      String
  project        ContentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  prompt         String
  negativePrompt String?

  provider       String
  model          String?

  width          Int
  height         Int
  format         ImageFormat

  storagePath    String?
  thumbnailPath  String?

  status         GenerationStatus @default(PENDING)
  errorMessage   String?

  // Wall-clock time spent inside provider.generate(), captured in
  // ImageService.generate() around the existing call — null for rows
  // created before this column existed. See docs/ASSET_LIBRARY.md.
  generationTimeMs Int?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([projectId])
}

model GeneratedContent {
  id        String      @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      ContentType
  prompt    String
  output    String
  model     String

  createdBy String?

  // See GeneratedImage.generationTimeMs — same capture point, same nullable
  // backfill story for pre-existing rows.
  generationTimeMs Int?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId])
}

model PromptTemplate {
  id          String      @id @default(cuid())

  name        String      @unique
  category    String
  contentType ContentType

  promptBody  String

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
}

model SavedPrompt {
  id          String      @id @default(cuid())

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable: null means a global, reusable prompt (the original, unchanged
  // behavior — still what the standalone Prompt Library page shows). A
  // non-null value scopes this prompt to one project, making it a real,
  // reviewable PROMPT_TEMPLATE asset in that project's Asset Library. See
  // docs/ASSET_LIBRARY.md.
  projectId   String?
  project     ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name        String
  promptBody  String
  contentType ContentType

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
  @@index([projectId])
}

// One row per underlying asset (GeneratedContent / GeneratedImage /
// SavedPrompt) that has ever been touched by the QA workflow — an asset
// with no row here is implicitly ReviewStatus.DRAFT (the service layer
// upserts a row lazily on first real review action). Deliberately not a
// column on the source tables: one polymorphic table serves every current
// and future asset type without altering any of them.
model AssetReview {
  id         String        @id @default(cuid())

  projectId  String
  project    ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType  AssetType
  sourceId   String

  status     ReviewStatus  @default(DRAFT)

  reviewerId String?
  reviewer   User?         @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?

  notes      String?
  qaScore    Int?
  checklist  Json?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([assetType, sourceId])
  @@index([projectId])
  @@index([status])
}

// One row per generated version of an asset, linked into a chain via
// previousVersionId. lineageId is shared by every version in one chain
// (equal to the first version's own id) so "get full history" is a single
// indexed findMany, not a chain walk. An asset with no row here is
// implicitly version 1 (created lazily on first regenerate).
model AssetVersion {
  id                String         @id @default(cuid())

  projectId         String
  project           ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType         AssetType
  sourceId          String

  lineageId         String
  versionNumber     Int

  previousVersionId String?
  previousVersion   AssetVersion?  @relation("VersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      AssetVersion[] @relation("VersionLineage")

  createdAt         DateTime       @default(now())

  @@unique([assetType, sourceId])
  @@index([projectId])
  @@index([lineageId])
}
