generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  PUBLISHED
}

enum ContentType {
  BLOG
  EMAIL
  SOCIAL_MEDIA
  MARKETING_COPY
  DOCUMENTATION
}

enum ImageFormat {
  PNG
  JPG
  WEBP
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

// Discriminates VideoAsset rows. SCRIPT/SCENE_BREAKDOWN/SHOT_LIST/
// VOICE_OVER_SCRIPT/CAPTIONS/SUBTITLES are text artifacts (ChatService,
// like GeneratedContent); STORYBOARD/THUMBNAIL are image artifacts
// (ImageProviderFactory, like GeneratedImage). See VideoAsset and
// src/config/video-prompts.ts.
//
// UPLOADED_SOURCE (Sprint 7.2.1) is a third shape sharing this same table:
// a real uploaded video file (durationMs/videoFormat/sourceFileName
// populated, storagePath is the actual file, no AI provider involved —
// status goes PENDING -> COMPLETED/FAILED around ffprobe + storage, same
// posture as the image-kind lifecycle). See VideoSourceService.
enum VideoAssetKind {
  SCRIPT
  SCENE_BREAKDOWN
  SHOT_LIST
  VOICE_OVER_SCRIPT
  CAPTIONS
  SUBTITLES
  STORYBOARD
  THUMBNAIL
  UPLOADED_SOURCE
  // Sprint 7.2.3 — the output of VideoExecutionEngineService running an
  // approved VideoWorkflowPlan's FFmpeg steps against an UPLOADED_SOURCE
  // file. Same shape as UPLOADED_SOURCE (durationMs/videoFormat/storagePath
  // all populated from ffprobe), provider is "ffmpeg" instead of "upload".
  EDITED_VIDEO
}

// Mirrors ContentType's five values exactly (a GeneratedContent.type value
// casts straight across, no mapping table) plus IMAGE, PROMPT_TEMPLATE,
// BRAND_KIT, and VIDEO — the additional real asset sources aggregated by
// the Asset Library. Adding a future asset type is one new enum value +
// one migration + one case in asset.mapper.ts, never a redesign of this
// enum's existing consumers — see docs/ASSET_LIBRARY.md.
enum AssetType {
  BLOG
  EMAIL
  SOCIAL_MEDIA
  MARKETING_COPY
  DOCUMENTATION
  IMAGE
  PROMPT_TEMPLATE
  BRAND_KIT
  VIDEO
}

enum ReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  REVISION_REQUESTED
}

// Append-only activity log for AssetReviewEvent — one row per
// review-relevant action (never updated/deleted except cascade). See
// ADR-0009. PUBLISH_* values added in Sprint 6.4 (ADR-0010) — the
// Publishing Pipeline feeds this same timeline rather than a second one.
enum ReviewEventType {
  STATUS_CHANGED
  COMMENT_ADDED
  COMMENT_RESOLVED
  ANNOTATION_ADDED
  ASSIGNED
  UNASSIGNED
  VERSION_CREATED
  PUBLISH_SCHEDULED
  PUBLISH_STARTED
  PUBLISHED
  PUBLISH_FAILED
}

// PublishingRecord's lifecycle — deliberately independent of ReviewStatus
// (QA and Publishing are separate workflows connected only via the shared
// (assetType, sourceId) key and the AssetReviewEvent timeline). See
// ADR-0010.
enum PublishingStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

// AnalyticsEvent's discriminator — deliberately separate from
// ReviewEventType (AssetReviewEvent is scoped to review-relevant activity
// by ADR-0009; generation happens before an asset ever enters that
// workflow). Room to grow additively, same posture as ReviewEventType. See
// ADR-0011.
enum AnalyticsEventType {
  GENERATED
}

model User {
  id String @id @default(cuid())

  email        String @unique
  passwordHash String
  name         String

  refreshToken String?

  isActive      Boolean @default(true)
  emailVerified Boolean @default(false)

  roles             UserRole[]
  savedPrompts      SavedPrompt[]
  contentProjects   ContentProject[]
  reviewedAssets    AssetReview[]
  brandKits         BrandKit[]
  comments          AssetComment[]
  assignedReviews   AssetReviewAssignment[] @relation("AssetAssignee")
  assignmentsGiven  AssetReviewAssignment[] @relation("AssetAssignedBy")
  reviewEvents      AssetReviewEvent[]
  publishingRecords PublishingRecord[]
  analyticsEvents   AnalyticsEvent[]

  automationConnections AutomationConnection[]
  mcpServersCreated     McpServerConfig[]
  automationAuditEvents AutomationAuditEvent[]

  financeAuditEvents FinanceAuditEvent[]

  aiAuditEvents AiAuditEvent[]

  assignedLeads  Lead[]         @relation("LeadAssignee")
  leadActivities LeadActivity[] @relation("LeadActivityActor")

  organizationMemberships OrganizationMember[]
  restaurantMemberships   RestaurantMember[]
  branchMemberships       BranchMember[]

  stockMovementsRecorded StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(cuid())

  name        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ContentProject {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  status ProjectStatus @default(DRAFT)

  generatedContent   GeneratedContent[]
  generatedImages    GeneratedImage[]
  savedPrompts       SavedPrompt[]
  assetReviews       AssetReview[]
  assetVersions      AssetVersion[]
  brandKits          BrandKit[]
  videoAssets        VideoAsset[]
  comments           AssetComment[]
  reviewAssignments  AssetReviewAssignment[]
  reviewEvents       AssetReviewEvent[]
  publishingRecords  PublishingRecord[]
  analyticsEvents    AnalyticsEvent[]
  videoWorkflowPlans VideoWorkflowPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GeneratedImage {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Optional: when set, generation folded this kit's tone/terminology/style
  // guidance into the prompt. SetNull, not Cascade — deleting a Brand Kit
  // must never delete the content generated while it was referenced. See
  // docs/ASSET_LIBRARY.md.
  brandKitId String?
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  prompt         String
  negativePrompt String?

  provider String
  model    String?

  width  Int
  height Int
  format ImageFormat

  storagePath   String?
  thumbnailPath String?

  status       GenerationStatus @default(PENDING)
  errorMessage String?

  // Wall-clock time spent inside provider.generate(), captured in
  // ImageService.generate() around the existing call — null for rows
  // created before this column existed. See docs/ASSET_LIBRARY.md.
  generationTimeMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model GeneratedContent {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // See GeneratedImage.brandKitId — same optional, SetNull relation.
  brandKitId String?
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  type   ContentType
  prompt String
  output String
  model  String

  createdBy String?

  // See GeneratedImage.generationTimeMs — same capture point, same nullable
  // backfill story for pre-existing rows.
  generationTimeMs Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model PromptTemplate {
  id String @id @default(cuid())

  name        String      @unique
  category    String
  contentType ContentType

  promptBody String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model SavedPrompt {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable: null means a global, reusable prompt (the original, unchanged
  // behavior — still what the standalone Prompt Library page shows). A
  // non-null value scopes this prompt to one project, making it a real,
  // reviewable PROMPT_TEMPLATE asset in that project's Asset Library. See
  // docs/ASSET_LIBRARY.md.
  projectId String?
  project   ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  name        String
  promptBody  String
  contentType ContentType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

// A reusable set of brand guidance a ContentProject can own one or more of.
// Generation (ContentService/ImageService) optionally references one via
// brandKitId, folding tone/terminology/style into the prompt — see those
// services' generate() methods. A BrandKit is itself a first-class Asset
// Library entry (AssetType.BRAND_KIT, sourceId = BrandKit.id), reviewed and
// versioned through the same polymorphic AssetReview/AssetVersion tables as
// every other asset type — no schema change needed there. See
// docs/ASSET_LIBRARY.md.
model BrandKit {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdBy String
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  name   String
  client String?

  // Simple {url, label}[] metadata rather than a stored file — no upload
  // pipeline exists yet for user-supplied assets (StorageProvider today
  // only ever persists provider-generated image bytes). See sprint log.
  logos Json?

  primaryColors   Json?
  secondaryColors Json?
  fonts           Json?
  typography      String?

  toneOfVoice  String?
  writingStyle String?
  audience     String?
  ctaStyle     String?

  approvedTerminology String[]
  restrictedWords     String[]

  brandGuidelines       String?
  imageStyle            String?
  socialMediaGuidelines String?

  isDefault Boolean @default(false)

  generatedContent GeneratedContent[]
  generatedImages  GeneratedImage[]
  videoAssets      VideoAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// A single video-production artifact belonging directly to a ContentProject
// (no VideoProject header entity — reaffirms this repo's single-project-
// hierarchy rule). videoGroupId groups artifacts that belong to "one video"
// without a second entity: a plain string, not a real relation. kind
// discriminates two shapes sharing this one table: text artifacts (output/
// model populated, status always COMPLETED at creation, same posture as
// GeneratedContent — no partial row ever exists) and image artifacts
// (provider/width/height/format/storagePath/status/errorMessage populated,
// full PENDING -> COMPLETED/FAILED lifecycle, same as GeneratedImage). See
// VideoAssetKind and src/services/video-asset.service.ts.
model VideoAsset {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // See GeneratedImage.brandKitId — same optional, SetNull relation.
  brandKitId String?
  brandKit   BrandKit? @relation(fields: [brandKitId], references: [id], onDelete: SetNull)

  videoGroupId String
  kind         VideoAssetKind

  prompt String

  // Text-kind output (SCRIPT/SCENE_BREAKDOWN/SHOT_LIST/VOICE_OVER_SCRIPT/
  // CAPTIONS/SUBTITLES) — mirrors GeneratedContent.output.
  output String?

  // Image-kind output (STORYBOARD/THUMBNAIL) — mirrors GeneratedImage.
  provider      String?
  width         Int?
  height        Int?
  format        ImageFormat?
  storagePath   String?
  thumbnailPath String?

  model String?

  status       GenerationStatus @default(PENDING)
  errorMessage String?

  generationTimeMs Int?
  createdBy        String?

  // UPLOADED_SOURCE-only real video file metadata (Sprint 7.2.1), captured
  // from ffprobe at ingestion time. videoFormat holds the container (e.g.
  // "mp4") — distinct from the image-only `format` column above, which
  // can't represent a video container. All three null for every other
  // kind. See VideoSourceService.
  durationMs     Int?
  videoFormat    String?
  sourceFileName String?

  // Sprint 7.2.4 — populated only for an EDITED_VIDEO produced by a workflow
  // plan containing a "subtitles" step (relative StorageProvider path to the
  // generated .srt, same convention as storagePath/thumbnailPath). Null for
  // every other row, including an EDITED_VIDEO whose plan had no subtitles
  // step. See VideoExecutionEngineService/WhisperTranscriptionProvider.
  subtitlePath String?

  // Sprint 7.2.2 — workflow plans generated against this source video.
  // Only ever populated for UPLOADED_SOURCE rows; see VideoWorkflowPlannerService.
  // Two distinct relations to VideoWorkflowPlan need explicit names to
  // disambiguate: this asset as a plan's *source*, vs. this asset as a
  // plan's *result* (Sprint 7.2.3 — see VideoWorkflowPlan below).
  workflowPlans        VideoWorkflowPlan[] @relation("VideoWorkflowPlanSource")
  resultOfWorkflowPlan VideoWorkflowPlan?  @relation("VideoWorkflowPlanResult")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([videoGroupId])
}

// Sprint 7.2.2 — a natural-language editing request converted into a
// validated, structured plan (see VideoWorkflowPlannerService). Sprint
// 7.2.3 added resultVideoAssetId/executedAt (both additive, nullable) once
// VideoExecutionEngineService could actually run a plan — deliberately not
// a full job/queue model (VideoEditJob): execution is synchronous this
// milestone, so "did this plan run, and what did it produce" is the only
// execution metadata actually needed.
model VideoWorkflowPlan {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  videoAssetId String
  videoAsset   VideoAsset @relation("VideoWorkflowPlanSource", fields: [videoAssetId], references: [id], onDelete: Cascade)

  // The user's original request, verbatim.
  prompt String

  // The validated { steps: [...] } plan — see WorkflowSchema. Never raw,
  // unvalidated model output.
  workflow Json

  // Which AI model produced this plan (ChatResponse.model), for debugging.
  model String?

  // Sprint 7.2.3 — set together, once, by VideoExecutionEngineService after
  // a successful run. SetNull (not Cascade): deleting the resulting
  // VideoAsset must never delete the plan that produced it.
  resultVideoAssetId String?     @unique
  resultVideoAsset   VideoAsset? @relation("VideoWorkflowPlanResult", fields: [resultVideoAssetId], references: [id], onDelete: SetNull)
  executedAt         DateTime?

  createdBy String?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([videoAssetId])
}

// One row per underlying asset (GeneratedContent / GeneratedImage /
// SavedPrompt) that has ever been touched by the QA workflow — an asset
// with no row here is implicitly ReviewStatus.DRAFT (the service layer
// upserts a row lazily on first real review action). Deliberately not a
// column on the source tables: one polymorphic table serves every current
// and future asset type without altering any of them.
model AssetReview {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  status ReviewStatus @default(DRAFT)

  reviewerId String?
  reviewer   User?     @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?

  notes     String?
  qaScore   Int?
  checklist Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetType, sourceId])
  @@index([projectId])
  @@index([status])
}

// One row per generated version of an asset, linked into a chain via
// previousVersionId. lineageId is shared by every version in one chain
// (equal to the first version's own id) so "get full history" is a single
// indexed findMany, not a chain walk. An asset with no row here is
// implicitly version 1 (created lazily on first regenerate).
model AssetVersion {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  lineageId     String
  versionNumber Int

  previousVersionId String?
  previousVersion   AssetVersion?  @relation("VersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      AssetVersion[] @relation("VersionLineage")

  createdAt DateTime @default(now())

  @@unique([assetType, sourceId])
  @@index([projectId])
  @@index([lineageId])
}

// General comments and annotations, unified in one table (an annotation is
// just a comment with an anchor). At most one anchor kind is set per row —
// region* for an image-region pin (normalized 0-1 floats), timestampMs for
// a video-artifact comment (a manually-entered logical marker; no real
// video file exists to sync playback against). Neither set = a general
// comment. See ADR-0009.
model AssetComment {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body       String
  isInternal Boolean @default(false)

  regionX      Float?
  regionY      Float?
  regionWidth  Float?
  regionHeight Float?
  timestampMs  Int?

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assetType, sourceId])
}

// Informational-only reviewer assignment — records who is intended to
// review an asset for planning/queue/timeline purposes. Does NOT grant the
// assignee access to the project; ContentProject remains single-owner
// (ADR-0007) unchanged. One active assignment per asset (assigning again
// replaces it). See ADR-0009.
model AssetReviewAssignment {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  assigneeId String
  assignee   User   @relation("AssetAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   User   @relation("AssetAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  note String?

  createdAt DateTime @default(now())

  @@unique([assetType, sourceId])
  @@index([projectId])
  @@index([assigneeId])
}

// Append-only activity log — one row per review-relevant action (status
// change, comment/annotation, resolve, assignment change, new version).
// Never updated or deleted except cascade on project delete. See ADR-0009.
model AssetReviewEvent {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  type ReviewEventType

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  fromStatus ReviewStatus?
  toStatus   ReviewStatus?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([assetType, sourceId])
  @@index([createdAt])
}

// One row per (asset, platform) publishing target — upsert-style like
// AssetReviewAssignment, not append-only (history of what happened lives in
// AssetReviewEvent, reused rather than duplicated). Publishing is gated on
// the asset's current AssetReview.status being APPROVED, checked in
// AssetService at schedule/publish time — deliberately not a DB constraint,
// since QA and Publishing are independent tables/workflows. platform is a
// PlatformProviderFactory registry key ("fake" today; real platforms are
// pluggable later without a schema change). See ADR-0010.
model PublishingRecord {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  platform String

  status       PublishingStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?

  externalId  String?
  externalUrl String?

  errorMessage String?
  attempts     Int     @default(0)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assetType, sourceId, platform])
  @@index([projectId])
  @@index([assetType, sourceId])
  @@index([status])
}

// One row per first-time generation — the one genuine gap in existing
// data: ContentService/ImageService/VideoAssetService.generate() never
// touch AssetReviewEvent (that table is only entered later, once the
// Asset Library/QA workflow is used). Deliberately a separate table from
// AssetReviewEvent, which ADR-0009 scoped to review-relevant activity
// specifically. provider/model/generationTimeMs/brandKitId are real
// columns, not buried in metadata, so provider-usage and generation-
// duration aggregation can group/average on them directly — mirroring
// GeneratedImage/VideoAsset's own provider/model columns rather than a
// JSON blob nothing can efficiently query. Written best-effort/fire-and-
// forget from the generation services — a failure here must never fail
// the generation request itself. See ADR-0011.
model AnalyticsEvent {
  id String @id @default(cuid())

  projectId String
  project   ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assetType AssetType
  sourceId  String

  type AnalyticsEventType

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  provider         String?
  model            String?
  generationTimeMs Int?
  // Deliberately a plain string, not a FK — an AnalyticsEvent must survive
  // its referenced BrandKit being deleted later (same reasoning
  // GeneratedImage.brandKitId's SetNull relation already establishes,
  // just without a relation at all here since this is a historical
  // snapshot, not a live reference).
  brandKitId       String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([assetType, sourceId])
  @@index([createdAt])
  @@index([provider])
}

// ---------------------------------------------------------------------------
// MCP Foundation (Sprint 7.1)
//
// The integration layer future automation providers (Canva, GitHub, Docker,
// Slack, ...) will register into — see McpServerConfig and
// McpConnectorFactory (backend/src/providers/mcp-connector.factory.ts), which
// mirrors ImageProviderFactory's registry shape exactly. No real provider is
// implemented yet; only "fake" is registered (FakeMcpConnector), the same
// posture FakeImageProvider had before Sprint 4.2's first real provider.
// ---------------------------------------------------------------------------

enum ConnectionStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum McpTransport {
  STDIO
  HTTP
  SSE
}

enum McpHealthStatus {
  UNKNOWN
  HEALTHY
  UNREACHABLE
  ERROR
}

enum AutomationAuditAction {
  CONNECTION_CREATED
  CONNECTION_TESTED
  CONNECTION_REVOKED
  MCP_SERVER_REGISTERED
  MCP_SERVER_UPDATED
  MCP_SERVER_REMOVED
  MCP_SERVER_HEALTH_CHECKED
  CREDENTIAL_ACCESSED
}

// A credential a user has stored for an external service, always encrypted
// at rest (encryptedCredentials/credentialsIv — see utils/encryption.ts).
// Strictly private to its owner: no role, Admin included, can read
// encryptedCredentials through any API response. Sprint 7.1 only supports
// storing an opaque credential blob (e.g. an API key) — OAuth authorize/
// callback flows are out of scope until a real provider needs them.
model AutomationConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String // McpConnectorFactory registry key, e.g. "fake", "github"
  label    String
  status   ConnectionStatus @default(PENDING)

  encryptedCredentials String
  credentialsIv        String

  metadata       Json?
  lastVerifiedAt DateTime?

  mcpServers McpServerConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider, label])
  @@index([userId])
  @@index([provider])
}

// One row per configured MCP server instance. `provider` is a
// McpConnectorFactory registry key (mirrors ImageProviderFactory's
// provider-name convention). Credentials, if the provider needs any, are
// referenced via connectionId rather than duplicated here.
model McpServerConfig {
  id   String @id @default(cuid())
  name String @unique

  provider  String
  transport McpTransport
  command   String? // stdio: spawned command
  args      String[] // stdio: args
  url       String? // http/sse: endpoint

  connectionId String?
  connection   AutomationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  isEnabled         Boolean         @default(true)
  healthStatus      McpHealthStatus @default(UNKNOWN)
  lastHealthCheckAt DateTime?
  lastHealthMessage String?

  config Json? // non-secret settings only

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // AI Core Foundation (Phase 1) — a Brain's per-server tool allowlist. See
  // AiBrainMcpTool; this reuses McpServerConfig entirely unchanged, no new
  // tool registry.
  aiBrainAllowances AiBrainMcpTool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([connectionId])
}

// Append-only activity log for the MCP Foundation — same posture as
// AssetReviewEvent (ADR-0009): never updated or deleted except cascade.
// Covers machine-initiated access (CREDENTIAL_ACCESSED), not just direct
// user actions, since that's the realistic threat model for a credential
// store.
model AutomationAuditEvent {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  action     AutomationAuditAction
  targetType String
  targetId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- Finance Management (Sprint A) ---------------------------------------
// Family expense/budget tracker. Shared workspace by design: every Finance
// row is visible/editable by any user holding the "finance" permission —
// there is no per-user ownership or filtering anywhere below. createdBy/
// updatedBy exist purely for audit (see FinanceAuditEvent), never for
// access control. See docs/product ADR-0013 (planned) for the first
// $transaction/Decimal usage this module introduces.

// Fixed, closed taxonomy — same posture as AssetType/ContentType/etc.
// (every comparable taxonomy in this schema is an enum, never a lookup
// table). Adding an 11th category later is one enum value + one migration.
enum ExpenseCategory {
  HOUSING
  FOOD
  UTILITIES
  TRANSPORTATION
  SHOPPING
  MEDICAL
  CREDIT_CARD
  SAVINGS
  TAX
  OTHERS
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

// Only MONTHLY is used in Sprint A; the enum shape is what makes
// WEEKLY/YEARLY additive later, not a redesign.
enum RecurrenceFrequency {
  MONTHLY
}

enum FinanceAuditAction {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  RECURRING_EXPENSE_TEMPLATE_CREATED
  RECURRING_EXPENSE_TEMPLATE_DEACTIVATED
  BUDGET_SET
}

model Expense {
  id String @id @default(cuid())

  // Future-proofing only — nullable, never filtered/joined on today. A real
  // Household model can be added later without touching existing rows.
  householdId String?

  date          DateTime // actual spend date (user-editable), distinct from createdAt
  amount        Decimal         @db.Decimal(10, 2)
  category      ExpenseCategory
  paymentMethod PaymentMethod?
  description   String?
  receiptPath   String? // relative StorageProvider path; upload UI ships in a later sprint

  // Lazy-generation traceability. Both null for a manually entered expense.
  recurringTemplateId String?
  recurringTemplate   RecurringExpenseTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  period              String? // "YYYY-MM" this instance was generated for

  // Audit only, never access control — same posture as this schema's
  // existing VideoAsset.createdBy / GeneratedContent.createdBy: a plain
  // string, not a relation, so no extra User back-relation is needed.
  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringTemplateId, period])
  @@index([date])
  @@index([category])
  @@index([recurringTemplateId])
}

model RecurringExpenseTemplate {
  id String @id @default(cuid())

  householdId String?

  name       String
  category   ExpenseCategory
  amount     Decimal             @db.Decimal(10, 2)
  frequency  RecurrenceFrequency @default(MONTHLY)
  dayOfMonth Int // 1-28, validator-enforced; clamped to the real last day of short months at generation time

  startDate DateTime
  isActive  Boolean  @default(true)

  // Lazy-generation checkpoint — "YYYY-MM" of the last period this
  // template successfully generated an Expense for. Null = never generated.
  lastGeneratedPeriod String?

  generatedExpenses Expense[]

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Budget {
  id String @id @default(cuid())

  householdId String?

  period       String  @unique // "YYYY-MM" — one row per calendar month, not a singleton
  monthlyLimit Decimal @db.Decimal(10, 2)

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mirrors AutomationAuditEvent exactly. Because Finance is a shared
// workspace with no per-user scoping, createdBy alone can't answer "who
// deleted this row" once it's gone — this append-only log fills that gap.
model FinanceAuditEvent {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  action     FinanceAuditAction
  targetType String
  targetId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- CRM Foundation (Sprint 1) --------------------------------------------
// First capability: AI-Assisted Lead Qualification. Shared workspace by
// design, same posture as Finance above — every Lead is visible/editable by
// any user holding the "crm" permission, no per-row ownership. Automation
// (n8n) integration (AI analysis write-back, execution logging, webhooks)
// is out of scope for Sprint 1 — LeadAiAnalysis and WorkflowExecutionLog
// exist now only so the schema doesn't need a second migration once Sprint
// 2/3 wire up n8n; nothing writes to them yet. See
// /home/eyancantimbuhan/.claude/plans/project-ai-sales-clever-dijkstra.md
// (TDD §8/§9/§14/§16) and docs/architecture/decisions/ADR-0018-crm-foundation.md.

enum LeadSource {
  WEBSITE_FORM
  MANUAL
  API
}

enum LeadStatus {
  NEW
  VALIDATED
  DISQUALIFIED
  AI_ANALYZED
  QUALIFIED
  CONTACTED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  AI_ANALYSIS
  AUTOMATION
  ASSIGNMENT
}

// Shared LOW/MEDIUM/HIGH scale reused across LeadAiAnalysis's buyingIntent,
// urgency, and riskLevel fields (TDD §14 review) — three distinct concepts,
// one taxonomy, so this doesn't multiply into three near-identical enums.
enum QualificationLevel {
  LOW
  MEDIUM
  HIGH
}

enum EstimatedTimeline {
  IMMEDIATE
  SHORT_TERM
  MEDIUM_TERM
  LONG_TERM
  UNKNOWN
}

enum WorkflowExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  RETRYING
}

model Lead {
  id String @id @default(cuid())

  // Future-proofing only, unused today — same posture as Expense.householdId.
  organizationId String?

  source LeadSource @default(WEBSITE_FORM)

  contactName String
  email       String
  phone       String?
  company     String?
  industry    String?
  companySize String?

  status   LeadStatus    @default(NEW)
  score    Int?
  priority LeadPriority?

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  lostReason String?

  // The original Lead Form payload, verbatim, for audit — distinct from the
  // structured fields above, which are the normalized/editable view of it.
  rawSubmission Json

  activities    LeadActivity[]
  aiAnalyses    LeadAiAnalysis[]
  executionLogs WorkflowExecutionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([assignedToId])
  @@index([createdAt])
}

// Serves as both "Activity History" and "Automation History" (TDD §9) —
// filtered by type in the UI, not two separate tables.
model LeadActivity {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type LeadActivityType

  // Null when system/automation-originated (Sprint 2+); always set for
  // rep-driven activity in Sprint 1.
  actorId String?
  actor   User?   @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  body     String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

// One row per AI analysis run (Sprint 3+ populates this; schema-only in
// Sprint 1). A lead can be re-analyzed — history is preserved, not
// overwritten. Fields mirror the TDD §14 JSON schema exactly, including the
// five fields added in the Phase 0.5 review.
model LeadAiAnalysis {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  provider      String
  model         String
  promptVersion String

  leadScore  Int
  confidence Float
  priority   LeadPriority

  industry               String?
  companySizeEstimate    String?
  budgetEstimateMin      Decimal? @db.Decimal(10, 2)
  budgetEstimateMax      Decimal? @db.Decimal(10, 2)
  budgetEstimateCurrency String?

  buyingIntent            QualificationLevel?
  urgency                 QualificationLevel?
  decisionMakerIdentified Boolean?
  estimatedTimeline       EstimatedTimeline?
  riskLevel               QualificationLevel?

  painPoints        String[]
  recommendedAction String
  summary           String
  reasoning         String

  rawResponse       Json
  needsManualReview Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// Platform-wide execution telemetry (TDD §16/§18 review — not CRM-owned),
// domain-tagged so a future automation project reuses this table instead of
// each domain minting its own. Schema-only in Sprint 1 — n8n doesn't exist
// as a caller yet, nothing writes to this table until Sprint 2.
model WorkflowExecutionLog {
  id String @id @default(cuid())

  domain       String @default("crm")
  workflowName String

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  n8nExecutionId String?

  status       WorkflowExecutionStatus
  durationMs   Int?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI Core Foundation (Phase 1)
//
// The shared AI platform every business module (CRM, Content, Video, Chat,
// and future modules) is meant to route AI calls through instead of each
// calling a provider directly — see /home/eyancantimbuhan/.claude/plans/
// project-ai-sales-clever-dijkstra.md (Technical Design Document, revised
// after the Phase 0.5 Architecture Review and frozen) and
// docs/architecture/decisions/ADR-0021-ai-core-foundation.md.
//
// Architecture (frozen): Business Module -> AiCapability -> AiBrain ->
// AiRoutingPolicy -> AiProvider/AiModel -> AiPrompt -> (Memory) -> (MCP
// Tools) -> Response. A business module or n8n workflow references an
// AiCapability by key only, never a Brain, Provider, Model, or Prompt
// directly — AiCapability resolves to exactly one AiBrain, which owns its
// own routing policy, prompt, and (later) memory/MCP configuration.
// AiBrain-direct invocation exists solely for administrative tooling (the
// AI Playground) — see ADR-0021.
//
// This mirrors MCP Foundation's proven shape (registry + service layer +
// CredentialManagerService reuse) and deliberately supersedes ADR-0001
// ("Single AI Provider, No Gateway") for text/chat generation specifically —
// ADR-0001 itself anticipated this ("Adding a second provider or a gateway
// later remains possible without reversing this decision... it hasn't been
// needed yet and shouldn't be built speculatively ahead of that need"). AI
// Core is that need, now real, and ADR-0021 records the supersession
// explicitly rather than silently overriding it.
//
// Phase 1 is purely additive: no existing table changes, and zero existing
// AI call sites (ChatService, ContentService, VideoWorkflowPlannerService,
// VideoAssetService, eyan-automation-hub Workflow 3) are modified. See TDD
// §16/§18 (Migration Plan) — Phase 2 migrates callers one at a time, Phase 3
// (separate approval) re-points Workflow 3 at AiCapability's invoke
// endpoint.
// ---------------------------------------------------------------------------

enum AiProviderKind {
  LOCAL
  HOSTED
}

enum AiMemoryStrategy {
  NONE
  CONVERSATION
  KNOWLEDGE_BASE
  VECTOR
  RAG
  LONG_TERM
}

enum AiRoutingStrategy {
  COST
  LATENCY
  QUALITY
  BALANCED
}

enum AiCallOutcome {
  VALID
  SCHEMA_INVALID
  TRANSIENT_FAILURE
  DEFINITIVE_FAILURE
}

// Sprint 4 — Conversation Engine. Mirrors AiCoreMessage's role union
// (system/user/assistant) as a Prisma enum, since a persisted message row
// needs a closed, indexable type rather than a plain string.
enum AiConversationRole {
  SYSTEM
  USER
  ASSISTANT
}

enum AiAuditAction {
  BRAIN_CREATED
  BRAIN_UPDATED
  BRAIN_DELETED
  CAPABILITY_CREATED
  CAPABILITY_UPDATED
  CAPABILITY_DELETED
  PROVIDER_CREATED
  PROVIDER_UPDATED
  MODEL_CREATED
  MODEL_UPDATED
  MODEL_DELETED
  PROVIDER_CREDENTIAL_ADDED
  PROVIDER_CREDENTIAL_ACCESSED
  PROVIDER_CREDENTIAL_ROTATED
  ROUTING_POLICY_CHANGED
  PROMPT_VERSION_CREATED
  PROMPT_VERSION_ACTIVATED
  PROMPT_VERSION_ROLLED_BACK
  MCP_TOOL_ALLOWANCE_CHANGED
}

// A pluggable text-generation provider — the AiProviderRegistry registry
// key (backend/src/providers/ai-core-provider.factory.ts) mirrors
// AiProvider.key exactly, the same provider-name convention
// ImageProviderFactory/McpConnectorFactory already established.
model AiProvider {
  id          String @id @default(cuid())
  key         String @unique // registry key: "ollama", "openai", "anthropic", "gemini", ...
  displayName String

  kind    AiProviderKind
  baseUrl String? // e.g. Ollama's host; null for hosted APIs using SDK/REST defaults

  isEnabled Boolean @default(true)

  // Reserved infrastructure only (Phase 0.5 review Finding 4) — nullable,
  // unenforced in Phase 1. A future hosted provider with a real published
  // quota populates this; rate-limit enforcement itself is Phase 4+.
  rateLimitPerMinute Int?

  // Reuses McpServerConfig's own health-field shape verbatim — actively
  // populated by AiProviderHealthService (mirrors McpHealthService).
  healthStatus      McpHealthStatus @default(UNKNOWN)
  lastHealthCheckAt DateTime?
  lastHealthMessage String?

  models                   AiModel[]
  credentials              AiProviderCredential[]
  routingPoliciesPreferred AiRoutingPolicy[]      @relation("PreferredProvider")
  routingPoliciesFallback  AiRoutingPolicy[]      @relation("FallbackProvider")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

// Encrypted, hosted-provider API key — identical shape to
// AutomationConnection, reusing CredentialManagerService verbatim (no new
// cryptography). Ollama (LOCAL) never has a row here — ADR-0020 Decision 1
// established Ollama needs no credential.
model AiProviderCredential {
  id         String     @id @default(cuid())
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  label String // e.g. "Production OpenAI key"

  encryptedCredentials String
  credentialsIv        String

  status         ConnectionStatus @default(PENDING)
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, label])
  @@index([providerId])
}

// A specific model a provider exposes. `tags` are technical abilities
// ("chat","coding","vision","reasoning","large-context") — never a business
// Capability name (Phase 0.5 Finding 2's naming rule; see AiCapability
// below for the business-task concept).
model AiModel {
  id         String     @id @default(cuid())
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  modelKey    String // "qwen2.5-coder:7b", "gpt-4o", "claude-3-5-sonnet-latest", ...
  displayName String
  tags        String[] // plain strings, not an enum — grows per-provider, never needs a migration

  contextWindow      Int?
  costPerInputToken  Decimal? @db.Decimal(12, 8)
  costPerOutputToken Decimal? @db.Decimal(12, 8)

  isEnabled Boolean @default(true)

  routingPoliciesPreferred AiRoutingPolicy[] @relation("PreferredModel")
  routingPoliciesFallback  AiRoutingPolicy[] @relation("FallbackModel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, modelKey])
  @@index([providerId])
}

// A named, business-facing AI configuration (provider/model/prompt/routing
// policy). A Brain is data, not code — adding a Brain is a seed/migration
// operation, never a new service class (TDD §3).
model AiBrain {
  id String @id @default(cuid())

  key         String @unique // "sales-brain", "content-brain", "general-chat-brain", ...
  name        String
  description String

  category String // "Sales","Support","Coding",... — string, not enum, same reason as AiModel.tags

  memoryStrategy AiMemoryStrategy @default(NONE)
  isEnabled      Boolean          @default(true)

  // Future-proofing only, unused today — same posture as Lead.organizationId.
  organizationId String?

  capabilities      AiCapability[]
  prompts           AiPrompt[]
  routingPolicies   AiRoutingPolicy[]
  mcpToolAllowances AiBrainMcpTool[]
  usageLogs         AiUsageLog[]
  conversations     AiConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// A named business task, resolving to exactly one Brain. This is the one
// thing a business module or n8n workflow ever references by key — never a
// Brain, Provider, Model, or Prompt directly (Phase 0.5 review Finding 1;
// architecture is frozen on this point, see ADR-0021). A Brain may back more
// than one Capability. onDelete deliberately left at Prisma's default
// (Restrict) — deleting a Brain that still backs an enabled Capability must
// fail loudly, not silently orphan the Capability, since this schema has no
// soft-delete anywhere to paper over a dangling reference.
model AiCapability {
  id String @id @default(cuid())

  key         String @unique // "lead-qualification", "email-drafting", "content-generation", ...
  name        String
  description String

  brainId String
  brain   AiBrain @relation(fields: [brainId], references: [id])

  isEnabled Boolean @default(true)

  usageLogs AiUsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brainId])
}

// Additive-only versioned prompt (ADR-0020 Decision 2's exact rule),
// never edited in place once a version exists. Rollback = activating an
// older version, never a delete.
model AiPrompt {
  id String @id @default(cuid())

  brainId String
  brain   AiBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  version  String // "v1","v2",...
  body     String  @db.Text
  isActive Boolean @default(false) // exactly one active version per brain, enforced by AiPromptService

  createdAt     DateTime       @default(now())
  aiEvaluations AiEvaluation[]

  @@unique([brainId, version])
  @@index([brainId])
}

// Additive-versioned routing configuration for a Brain (same isActive
// convention as AiPrompt). requiredTag (renamed from requiredCapability —
// Phase 0.5 Finding 2) is a technical AiModel.tags filter, never a business
// Capability.
model AiRoutingPolicy {
  id String @id @default(cuid())

  brainId String
  brain   AiBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  isActive Boolean           @default(false) // exactly one active row per brain, enforced by AiRoutingPolicyService, not the DB
  strategy AiRoutingStrategy @default(BALANCED)

  requiredTag String? // e.g. "reasoning" — filters AiModel.tags before falling back to preferredModelId

  preferredProviderId String
  preferredProvider   AiProvider @relation("PreferredProvider", fields: [preferredProviderId], references: [id])
  preferredModelId    String
  preferredModel      AiModel    @relation("PreferredModel", fields: [preferredModelId], references: [id])

  fallbackProviderId String?
  fallbackProvider   AiProvider? @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])
  fallbackModelId    String?
  fallbackModel      AiModel?    @relation("FallbackModel", fields: [fallbackModelId], references: [id])

  maxRetries Int @default(3)
  timeoutMs  Int @default(60000)

  confidenceHighThreshold   Float @default(0.75)
  confidenceMediumThreshold Float @default(0.4)

  createdAt DateTime @default(now())

  @@index([brainId])
  @@index([preferredProviderId])
}

// Thin join between a Brain and MCP Foundation's existing McpServerConfig —
// no new tool registry. allowedTools empty = every tool on that server.
model AiBrainMcpTool {
  id String @id @default(cuid())

  brainId String
  brain   AiBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  mcpServerConfigId String
  mcpServerConfig   McpServerConfig @relation(fields: [mcpServerConfigId], references: [id], onDelete: Cascade)

  allowedTools String[]

  @@unique([brainId, mcpServerConfigId])
  @@index([brainId])
}

// Fire-and-forget per-call telemetry, real columns not JSON (same reasoning
// as AnalyticsEvent). domain distinguishes production Capability/Brain
// traffic ("ai-core") from AI Playground executions ("ai-core-playground"),
// which are always excluded from default usage/cost reporting (Phase 0.5
// Finding 5) — mirrors WorkflowExecutionLog's own domain-tagging
// convention (ADR-0018 Decision 4).
model AiUsageLog {
  id String @id @default(cuid())

  brainId String?
  brain   AiBrain? @relation(fields: [brainId], references: [id], onDelete: SetNull)

  capabilityId String? // null for Playground/admin Brain-direct calls
  capability   AiCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)

  providerId String?
  modelId    String?

  workflowExecutionId String? // correlates to WorkflowExecutionLog.n8nExecutionId (Phase 3)
  domain              String  @default("ai-core") // "ai-core" | "ai-core-playground"

  outcome    AiCallOutcome
  retryCount Int           @default(0)

  tokensIn  Int?
  tokensOut Int?
  costUsd   Decimal? @db.Decimal(10, 6)
  latencyMs Int?

  needsManualReview Boolean @default(false)
  errorMessage      String?

  createdAt DateTime @default(now())

  @@index([brainId])
  @@index([capabilityId])
  @@index([providerId])
  @@index([domain])
  @@index([createdAt])
}

// Sprint 4 — Conversation Engine. A persisted multi-turn chat session tied
// directly to a Brain (never a Capability — the frozen "Conversation ->
// Brain" chain is a deliberate, sprint-directed exception to the
// Capability-only rule invoke() enforces for one-shot task execution;
// conversations are a stateful, continuously-configured interaction, not a
// discrete business task). Purely additive: nothing in Sprint 2/3's schema
// changes, and a caller that never supplies a conversationId never creates
// one of these rows (ChatService's existing stateless behavior is
// unaffected — see AiConversationService).
model AiConversation {
  id String @id @default(cuid())

  brainId String
  brain   AiBrain @relation(fields: [brainId], references: [id], onDelete: Cascade)

  metadata Json?

  messages AiConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brainId])
}

model AiConversationMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiConversationRole
  content String             @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId])
}

// A stored test case for a prompt version, run via AiEvaluationService /
// the Playground's "Evaluate" action before a version is activated.
model AiEvaluation {
  id String @id @default(cuid())

  promptId String
  prompt   AiPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  testCaseName  String
  input         Json
  expectedShape Json?
  actualOutput  Json?

  passed Boolean
  score  Float?

  evaluatedAt DateTime @default(now())

  @@index([promptId])
}

// Append-only audit trail — identical shape to AutomationAuditEvent /
// FinanceAuditEvent, one .record() entrypoint (AiAuditService). Also the
// hook AiRoutingService's in-memory cache invalidation listens to (TDD §8).
model AiAuditEvent {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     AiAuditAction
  targetType String
  targetId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- Restaurant Operations Platform: Tenancy Foundation (Sprint 0) -------
// Platform-level multi-tenancy — introduced for Restaurant Operations (the
// first commercial business module) but designed for reuse by any future
// module. Organization is the one reusable tenant/membership/billing root;
// Restaurant and Branch are this module's own domain vocabulary beneath
// it — a future module (Retail, Salon, ...) defines its own children under
// Organization rather than reusing Restaurant/Branch. See ADR-0025 and
// ADR-0026. Restaurant business data (Menu/Ingredients/Suppliers/Inventory/
// Daily Closing/...) does not exist yet — this migration is tenancy
// foundation only, no business tables.
// Sprint 1.2 (ADR-0036) — expanded from OWNER/MANAGER/STAFF to the named
// operational roles a real restaurant business actually uses. STAFF is kept
// (Postgres enum values can't be cleanly dropped) but is no longer assigned
// by any code path going forward — every new membership uses one of the
// named roles below.
enum TenantRole {
  OWNER
  MANAGER
  STAFF
  SUPERVISOR
  CASHIER
  KITCHEN
  INVENTORY_STAFF
  ACCOUNTANT
}

model Organization {
  id String @id @default(cuid())

  name String

  members     OrganizationMember[]
  restaurants Restaurant[]
  modules     OrganizationModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Membership grants access to every Restaurant under the Organization
// (and, transitively, every Branch under those). Composite-keyed junction,
// same shape as UserRole — no separate id.
model OrganizationMember {
  userId         String
  organizationId String

  role TenantRole

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, organizationId])
  @@index([userId])
}

// A restaurant brand under an Organization (e.g. Burger's Ink). Owns Menu,
// Categories, Ingredients, Recipes, Suppliers. Sprint 1.1 (ADR-0025/0026)
// adds Menu/MenuCategory as the first of these — Ingredients, Recipes,
// Suppliers still don't exist.
model Restaurant {
  id             String @id @default(cuid())
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  members        RestaurantMember[]
  branches       Branch[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]

  units                Unit[]
  ingredientCategories IngredientCategory[]
  suppliers            Supplier[]
  ingredients          Ingredient[]
  recipes              Recipe[]
  recipeIngredients    RecipeIngredient[]
  inventoryItems       InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// Scopes a user to one Restaurant (and implicitly all its Branches),
// without requiring Organization-wide access. Same junction shape as
// OrganizationMember.
model RestaurantMember {
  userId       String
  restaurantId String

  role TenantRole

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, restaurantId])
  @@index([userId])
}

// A physical location under a Restaurant (e.g. Burger's Ink - Downtown).
// Owns Inventory, Inventory Transactions, Purchases, Expenses, Daily
// Closing, Sales, and Reports once those ship — none of that exists yet.
// Branch-level membership was deliberately not modeled at first (YAGNI,
// ADR-0025) "until a real customer needs per-location staff restriction" —
// Sprint 1.2's Staff Management (ADR-0036) is that real need, so
// `BranchMember` below fulfills the condition ADR-0025 itself set.
model Branch {
  id           String @id @default(cuid())
  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name String

  members BranchMember[]

  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// Scopes a user to one Branch, without requiring Restaurant- or
// Organization-wide access. Same junction shape as OrganizationMember/
// RestaurantMember — see ADR-0036.
model BranchMember {
  userId   String
  branchId String

  role TenantRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([userId])
}

enum MenuItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Restaurant-owned master data (Sprint 1.1, ADR-0025/0026) — Menu Categories
// group a Restaurant's Menu Items (e.g. Burger's Ink: Burgers, Wraps,
// Hotdogs). Restaurant-scoped, not Branch-scoped, per the approved
// ownership model in .context/restaurant.md. Every query must filter by
// restaurantId — no exceptions.
model MenuCategory {
  id           String @id @default(cuid())
  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String
  displayOrder Int    @default(0)

  menuItems MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// A single sellable item on a Restaurant's menu, belonging to one
// MenuCategory. restaurantId is denormalized (not derived via
// menuCategoryId) so every repository query here can filter by it directly,
// per this module's tenant-isolation rule. No Inventory/Ingredient linkage
// yet (Sprint 2+) — this is master data only.
model MenuItem {
  id             String @id @default(cuid())
  restaurantId   String
  menuCategoryId String

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  imagePath   String? // relative StorageProvider path or URL; upload UI is a later sprint, same posture as Expense.receiptPath
  available   Boolean        @default(true) // day-to-day "in stock right now" toggle
  status      MenuItemStatus @default(DRAFT) // menu-building lifecycle, independent of `available`

  recipe Recipe?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([menuCategoryId])
}

// Per-Organization module enablement — the Module Registry's DB half (see
// ADR-0026). moduleKey references the in-code catalog
// (backend/src/config/module-registry.ts) by a free string, the same
// posture Permission.name already uses for RBAC, so enabling a future
// module for a customer is a config row, never a schema migration. This
// gates nav/route *visibility* only — requirePermission/requireRestaurantAccess
// remain the actual request-level enforcement.
model OrganizationModule {
  organizationId String
  moduleKey      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled   Boolean  @default(true)
  enabledAt DateTime @default(now())

  @@id([organizationId, moduleKey])
}

// Restaurant Product Foundation (Sprint 1.3). Restaurant owns Ingredients,
// Suppliers, Units, Ingredient Categories, and Recipes — Inventory (Branch-
// scoped, Sprint 2+) will only manage stock against these, never own
// product knowledge itself. See .context/restaurant.md and ADR-0037.

// Restaurant-scoped unit-of-measure master list (g, kg, ml, piece, ...).
// Deliberately not hardcoded/global — different restaurants may want
// different vocabularies (ADR-0037), same posture as IngredientCategory.
model Unit {
  id           String @id @default(cuid())
  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String
  abbreviation String

  recipeIngredients RecipeIngredient[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// Restaurant-scoped, configurable grouping for Ingredients (Vegetables,
// Cheese, Meat, ...). Optional on Ingredient — deleting a category
// un-categorizes its ingredients rather than deleting them (SetNull below),
// unlike MenuCategory/MenuItem's ownership cascade: a category here is a
// soft label, not a parent that owns its children's lifecycle.
model IngredientCategory {
  id           String @id @default(cuid())
  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name String

  ingredients Ingredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// Restaurant-scoped supplier contact. No pricing/purchasing yet (Sprint
// 2+, ADR-0037) — only the relationship to which Ingredients each Supplier
// can provide (IngredientSupplier below).
model Supplier {
  id           String @id @default(cuid())
  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?
  notes String?

  ingredients IngredientSupplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// Restaurant-scoped raw/purchasable product (e.g. Lettuce, Beef Patty).
// Owns no stock/quantity — that's Inventory's job (Branch-scoped, Sprint
// 2+, deliberately not built yet per ADR-0037: Inventory only manages
// stock, never product knowledge).
model Ingredient {
  id                   String  @id @default(cuid())
  restaurantId         String
  ingredientCategoryId String?

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   IngredientCategory? @relation(fields: [ingredientCategoryId], references: [id], onDelete: SetNull)

  name String

  suppliers         IngredientSupplier[]
  recipeIngredients RecipeIngredient[]
  inventoryItems    InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([ingredientCategoryId])
}

// Many-to-many: a Supplier may supply many Ingredients, an Ingredient may
// have many Suppliers (confirmed by Burger's Ink's real order sheet — "oil"
// is sourced from two different suppliers). No pricing on this join yet —
// that's Sprint 2+ (Purchases/ADR-0037), deliberately excluded here.
model IngredientSupplier {
  ingredientId String
  supplierId   String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([ingredientId, supplierId])
  @@index([supplierId])
}

// One Recipe per MenuItem (menuItemId is unique below) — "what ingredients
// are consumed when this product is sold." No stock deduction yet
// (Inventory, Sprint 2+) — this is the product-knowledge foundation only.
model Recipe {
  id           String @id @default(cuid())
  restaurantId String
  menuItemId   String @unique

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  notes String?

  ingredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// One line of a Recipe: this Ingredient, this Quantity, this Unit.
// restaurantId is denormalized (not derived via recipeId), same posture as
// MenuItem.restaurantId, so every repository query here can filter by it
// directly per this module's tenant-isolation rule.
model RecipeIngredient {
  id           String @id @default(cuid())
  restaurantId String
  recipeId     String
  ingredientId String
  unitId       String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  quantity Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
  @@index([restaurantId])
  @@index([recipeId])
  @@index([ingredientId])
}

// --- Inventory Foundation (Sprint 2A, ADR-0038) ---------------------------
// Branch-scoped, per ADR-0037 Decision 1: Restaurant owns product knowledge
// (Ingredient/Unit above); Branch owns stock. InventoryItem is "how much of
// this Ingredient is on hand at this Branch right now" — restaurantId is
// denormalized (not derived via branchId) for the same tenant-isolation-
// filtering reason every other Restaurant Operations table denormalizes it.
// No recipe consumption, purchasing, or costing yet — see ADR-0038.

enum StockMovementType {
  OPENING_STOCK
  ADJUSTMENT
  WASTE
  STOCK_COUNT
  // PURCHASE and RECIPE_CONSUMPTION are reserved for Sprint 3 / Sprint 2B —
  // adding them later is a purely additive enum value, no redesign.
}

model InventoryItem {
  id           String @id @default(cuid())
  branchId     String
  restaurantId String
  ingredientId String
  unitId       String

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Maintained running balance, written only inside the same transaction as
  // the StockMovement row that changes it (see stock-movement.repository.ts)
  // — never mutated on its own, so it can't drift from the movement ledger.
  currentQuantity Decimal @default(0) @db.Decimal(10, 2)
  minimumQuantity Decimal @default(0) @db.Decimal(10, 2)

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@index([restaurantId])
  @@index([ingredientId])
}

// Append-only audit ledger — the source of truth for how an InventoryItem's
// currentQuantity got to where it is. branchId/unitId are denormalized onto
// the row (not derived via inventoryItemId) so this stays a self-contained,
// directly-filterable audit record, same posture as RecipeIngredient's own
// denormalized restaurantId.
model StockMovement {
  id              String @id @default(cuid())
  inventoryItemId String
  branchId        String
  unitId          String

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type StockMovementType

  // Signed: positive increases stock, negative decreases it.
  quantityDelta Decimal @db.Decimal(10, 2)
  // Running balance snapshot immediately after this movement was applied —
  // makes history self-explanatory without recomputation.
  quantityAfter Decimal @db.Decimal(10, 2)

  reason String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([branchId])
  @@index([createdAt])
}
