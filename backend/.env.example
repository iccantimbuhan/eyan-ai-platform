NODE_ENV=development

PORT=3001

DATABASE_URL="postgresql://username:password@localhost:5432/database?schema=public"

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MAX_TOKENS=500

JWT_SECRET=your-jwt-secret

JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your-refresh-token-secret

REFRESH_TOKEN_EXPIRES_IN=7d

# Local-disk StorageProvider. STORAGE_LOCAL_ROOT defaults to <cwd>/storage/images
# if unset. STORAGE_PUBLIC_BASE_URL is the URL prefix stored files are served
# under (not yet wired to a serving route — see Sprint 4.1 Phase 2).
STORAGE_LOCAL_ROOT=./storage/images
STORAGE_PUBLIC_BASE_URL=/uploads/images

# ImageProviderFactory.create()'s default provider name. No provider is
# registered yet as of Sprint 4.1 Phase 3 — leave unset until one is added.
IMAGE_PROVIDER=

# Encrypts AutomationConnection.encryptedCredentials (Sprint 7.1 MCP
# Foundation). Must be base64-encoded and decode to exactly 32 bytes
# (AES-256). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No default — the server still boots without it, but CredentialManagerService
# fails fast with a clear error the first time a connection is actually
# created/revealed/rotated without one configured.
AUTOMATION_ENCRYPTION_KEY=
