NODE_ENV=development

PORT=3001

DATABASE_URL="postgresql://username:password@localhost:5432/database?schema=public"

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MAX_TOKENS=500

JWT_SECRET=your-jwt-secret

JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your-refresh-token-secret

REFRESH_TOKEN_EXPIRES_IN=7d

# Local-disk StorageProvider. STORAGE_LOCAL_ROOT defaults to <cwd>/storage/images
# if unset. STORAGE_PUBLIC_BASE_URL is the URL prefix stored files are served
# under (not yet wired to a serving route — see Sprint 4.1 Phase 2).
STORAGE_LOCAL_ROOT=./storage/images
STORAGE_PUBLIC_BASE_URL=/uploads/images

# ImageProviderFactory.create()'s default provider name. No provider is
# registered yet as of Sprint 4.1 Phase 3 — leave unset until one is added.
IMAGE_PROVIDER=

# Encrypts AutomationConnection.encryptedCredentials (Sprint 7.1 MCP
# Foundation). Must be base64-encoded and decode to exactly 32 bytes
# (AES-256). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# No default — the server still boots without it, but CredentialManagerService
# fails fast with a clear error the first time a connection is actually
# created/revealed/rotated without one configured.
AUTOMATION_ENCRYPTION_KEY=

# Sprint 2 — CRM Automation Integration Contract (ADR-0019). Platform-level
# automation secrets shared with eyan-automation-hub (n8n) — a future
# automation domain reuses both without a rename (ADR-0018 Decision 6). No
# default; the server still boots without them, but every /api/v1/crm/service/*
# call is rejected (fail-closed) until AUTOMATION_SERVICE_API_KEY is set, and
# outbound lead-intake dispatch is skipped until AUTOMATION_WEBHOOK_SIGNING_SECRET
# is set. Generate either with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTOMATION_SERVICE_API_KEY=

AUTOMATION_WEBHOOK_SIGNING_SECRET=

# Full URL of n8n's Lead Intake webhook (eyan-automation-hub, Workflow 1).
# Leave unset in any environment without an Automation Hub instance running.
AUTOMATION_HUB_WEBHOOK_URL=

# Full URL of n8n's Sales Automation webhook (eyan-automation-hub, Workflow 4
# — Sprint 5). Leave unset in any environment without an Automation Hub
# instance running.
AUTOMATION_HUB_LEAD_QUALIFIED_WEBHOOK_URL=

AUTOMATION_WEBHOOK_TIMEOUT=5000
